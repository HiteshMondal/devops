################################################################################
# DevOps Project — Environment Configuration
################################################################################
# Usage:
#   1. Copy this file to `.env`
#   2. Update ALL required values
#   3. Run: ./run.sh
#
# CI/CD Variables:
#   - GitHub Actions → Repo Settings → Secrets and variables → Actions
#   - GitLab         → Project Settings → CI/CD → Variables
#
# Designed to be compatible with major Linux distributions and WSL.
# Supports all Kubernetes tools: Minikube, Kind, K3s, EKS, GKE, AKS, MicroK8s or others.
# .env is the SINGLE SOURCE OF TRUTH for Ports, Variables, and Secrets.
# run.sh is the SINGLE AUTHORITY for Local/Production mode and execution flow.

# IMPORTANT:
# Changing values may cause errors or conflicts if dependent configuration is not updated accordingly.


################################################################################
# APPLICATION CONFIGURATION
################################################################################

APP_NAME=devops-app
NAMESPACE=devops-app
APP_PORT=8000

# Runtime configuration
LOG_LEVEL=info

# Replica & Autoscaling configuration
REPLICAS=2
MIN_REPLICAS=2
MAX_REPLICAS=10
CPU_TARGET_UTILIZATION=70
MEMORY_TARGET_UTILIZATION=80

# Resource requests & limits
APP_CPU_REQUEST=100m
APP_CPU_LIMIT=500m
APP_MEMORY_REQUEST=128Mi
APP_MEMORY_LIMIT=512Mi


################################################################################
# INGRESS CONFIGURATION (OPTIONAL)
################################################################################

# Enable or disable Kubernetes Ingress
INGRESS_ENABLED=true

# Ingress hostname
# NOTE: For local clusters, add this to /etc/hosts
INGRESS_HOST=devops-app.local

# Ingress controller class
# Common values:
#   nginx   — minikube, kind, microk8s
#   traefik — k3s
#   alb     — AWS EKS
#   gce     — GKE
#   azure/application-gateway — AKS
INGRESS_CLASS=nginx

# TLS secret name (used mainly in production with cert-manager)
TLS_SECRET_NAME=devops-app-tls


################################################################################
# DOCKER / CONTAINER REGISTRY
################################################################################

# DockerHub credentials (required if BUILD_PUSH=true)
DOCKERHUB_USERNAME=yourdockerhubusername
DOCKERHUB_PASSWORD=your-dockerhub-password-or-token

# Image tag to use
DOCKER_IMAGE_TAG=latest


################################################################################
# GIT & GITHUB CONFIGURATION
################################################################################

# Git author configuration
GIT_AUTHOR_NAME=Your_Name
GIT_AUTHOR_EMAIL=you@example.com

# GitHub configuration
GITHUB_USERNAME=yourgithubusername
GITHUB_EMAIL=yourmail@example.com
GITHUB_TOKEN=your-github-personal-access-token

# Repository URL
GIT_REPO_URL=https://github.com/HiteshMondal/devops.git

# Repository branch
GIT_REPO_BRANCH=main


################################################################################
# KUBERNETES CLUSTER TOOLING
# Kind / K3d — used by deploy_kubernetes.sh
################################################################################

KIND_CLUSTER_NAME=
K3D_CLUSTER_NAME=

# Kind / K3d application ports
KIND_APP_NODE_PORT=30080
KIND_METRICS_NODE_PORT=30300
KIND_PROMETHEUS_NODE_PORT=30900
KIND_GRAFANA_NODE_PORT=30430
KIND_HTTP_PORT=8081
KIND_HTTPS_PORT=8443


################################################################################
# DATABASE CONFIGURATION (OPTIONAL)
# Injected via Kubernetes ConfigMaps / Secrets
################################################################################

DB_HOST=localhost
DB_PORT=5432
DB_NAME=devopsdb
DB_USERNAME=devops
DB_PASSWORD='INSIDE QUOTES'
DB_SQLITE_PATH=/data/app.db

################################################################################
# APPLICATION SECRETS (OPTIONAL)
# Stored as Kubernetes Secrets
################################################################################

JWT_SECRET='$(openssl rand -base64 32)'
API_KEY=
SESSION_SECRET=


################################################################################
# ARGOCD CONFIGURATION
################################################################################

ARGOCD_NAMESPACE=argocd
ARGOCD_VERSION=v2.10.0

ARGOCD_LOCAL_PORT=8080
ARGOCD_SERVER_PORT=443

ARGOCD_ADMIN_PASSWORD=

ARGOCD_SYNC_WAVE_ENABLED=true


################################################################################
# ARGOCD APPLICATIONS / NAMESPACES
################################################################################

# Applications
PROMETHEUS_NAMESPACE=monitoring
LOKI_NAMESPACE=loki
TRIVY_NAMESPACE=trivy


################################################################################
# ARGOCD APPLICATION PORTS
################################################################################

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TRIVY_EXPORTER_PORT=8082


################################################################################
# ARGOCD GIT REPOSITORY PATHS
################################################################################

# Add under the ARGOCD section of .env
GIT_REPO_PATH_APP=platform/deployment/kubernetes/base
GIT_REPO_PATH_MONITORING=monitoring/prometheus
GIT_REPO_PATH_LOKI=monitoring/loki
GIT_REPO_PATH_TRIVY=monitoring/trivy


################################################################################
# INFRA / TERRAFORM CONFIGURATION (AWS — Free Tier sized)
################################################################################

AWS_REGION=us-east-1

# Optional overrides
# TF_VAR_kubernetes_version=1.30
# TF_VAR_node_instance_type=t3.micro
# TF_VAR_node_desired_size=1
# TF_VAR_db_instance_class=db.t3.micro
# TF_VAR_db_allocated_storage=20
# TF_VAR_enable_nat_gateway=false
# TF_VAR_db_deletion_protection=false


################################################################################
# AZURE PULUMI
################################################################################

PULUMI_STACK=HiteshMondal/devops-platform-azure/prod

AZURE_LOCATION=eastus

AZURE_AKS_VM_SIZE=Standard_B2s
AZURE_AKS_NODE_COUNT=1

AZURE_POSTGRES_SKU=Standard_B1ms
AZURE_POSTGRES_STORAGE_GB=32
AZURE_POSTGRES_VERSION=16


################################################################################
# GCP OPENTOFU CONFIGURATION (Free-tier oriented)
################################################################################
GCP_PROJECT_ID=devops-app-31032004
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

GKE_CLUSTER_NAME=devops-app-cluster
GKE_NODE_COUNT=1
GKE_MACHINE_TYPE=e2-small
GKE_DISK_SIZE_GB=30

CLOUDSQL_TIER=db-f1-micro
CLOUDSQL_DISK_SIZE_GB=10
CLOUDSQL_VERSION=POSTGRES_15

# Path to a service-account JSON key, or leave empty to use
# `gcloud auth application-default login` on this machine.
GOOGLE_APPLICATION_CREDENTIALS=


################################################################################
# MONITORING — PROMETHEUS
################################################################################

PROMETHEUS_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_SCRAPE_TIMEOUT=10s
PROMETHEUS_RETENTION=15d
PROMETHEUS_STORAGE_SIZE=10Gi

# Resource requests & limits
PROMETHEUS_CPU_REQUEST=200m
PROMETHEUS_CPU_LIMIT=500m
PROMETHEUS_MEMORY_REQUEST=256Mi
PROMETHEUS_MEMORY_LIMIT=512Mi


################################################################################
# MONITORING — GRAFANA
################################################################################

GRAFANA_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_STORAGE_SIZE=5Gi

# Resource requests & limits
GRAFANA_CPU_REQUEST=100m
GRAFANA_CPU_LIMIT=200m
GRAFANA_MEMORY_REQUEST=128Mi
GRAFANA_MEMORY_LIMIT=256Mi


################################################################################
# MONITORING — TRIVY
################################################################################

TRIVY_ENABLED=true
TRIVY_METRICS_ENABLED=true
TRIVY_BUILD_IMAGES=true

# Scan configuration
TRIVY_SCAN_SCHEDULE="0 16-22 * * *"
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_VERSION=0.57.1
TRIVY_IMAGE_TAG=1.1
SCAN_INTERVAL=300

# Resource requests & limits
TRIVY_CPU_REQUEST=500m
TRIVY_CPU_LIMIT=2000m
TRIVY_MEMORY_REQUEST=512Mi
TRIVY_MEMORY_LIMIT=2Gi


################################################################################
# MONITORING — LOKI
################################################################################

LOKI_ENABLED=true
LOKI_VERSION=3.0.0
LOKI_RETENTION_PERIOD=168h
LOKI_STORAGE_SIZE=10Gi
LOKI_SERVICE_TYPE=ClusterIP

# Resource requests & limits
LOKI_CPU_REQUEST=100m
LOKI_CPU_LIMIT=1000m
LOKI_MEMORY_REQUEST=256Mi
LOKI_MEMORY_LIMIT=1Gi