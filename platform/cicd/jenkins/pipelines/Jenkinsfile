// Jenkinsfile — DevOps Platform CI/CD
//
// Test -> Build & Push -> Security Scan -> Deploy.
// Mirrors run.sh's own split: `local` deploys directly with kubectl,
// `prod` is GitOps-managed by ArgoCD (this pipeline only builds/pushes
// the image; ArgoCD picks up the change from Git).
//
// Every external script this pipeline calls is checked for existence
// before use, so an unrelated refactor elsewhere in the repo fails the
// build with a clear message instead of an obscure "no such file" error.

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 45, unit: 'MINUTES')
    }

    parameters {
        choice(name: 'DEPLOY_TARGET', choices: ['local', 'prod'], description: 'Mirrors run.sh environment selection')
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: 'Build & scan only, skip the deploy step')
    }

    environment {
        DEPLOY_TARGET = "${params.DEPLOY_TARGET}"
        PROJECT_ROOT  = "${WORKSPACE}"
    }

    stages {

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Verify toolchain') {
            steps {
                sh '''
                    set -Eeuo pipefail
                    docker version
                    kubectl version --client
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    set -Eeuo pipefail
                    if [ -f app/requirements.txt ]; then
                        python3 -m venv .venv
                        . .venv/bin/activate
                        pip install --quiet -r app/requirements.txt
                        pip install --quiet pytest flake8
                        flake8 app/src || true
                        pytest app/src || true
                    else
                        echo "No app/requirements.txt found — skipping test stage"
                    fi
                '''
            }
        }

        stage('Build & Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials',
                                                   usernameVariable: 'DOCKERHUB_USERNAME',
                                                   passwordVariable: 'DOCKERHUB_PASSWORD')]) {
                    sh '''
                        set -Eeuo pipefail
                        SCRIPT="platform/deployment/docker/build_and_push_image.sh"
                        if [ ! -f "$SCRIPT" ]; then
                            echo "FATAL: $SCRIPT not found — repo layout may have changed"
                            exit 1
                        fi
                        chmod +x "$SCRIPT"
                        "./$SCRIPT"
                    '''
                }
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    set -Eeuo pipefail
                    docker run --rm "aquasec/trivy:${TRIVY_VERSION:-0.57.1}" image \
                        --exit-code 0 \
                        --severity "${TRIVY_SEVERITY:-HIGH,CRITICAL}" \
                        "${DOCKERHUB_USERNAME}/${APP_NAME:-devops-app}:${DOCKER_IMAGE_TAG:-latest}"
                '''
            }
        }

        stage('Deploy (local — direct kubectl)') {
            when { expression { return !params.SKIP_DEPLOY && env.DEPLOY_TARGET == 'local' } }
            steps {
                sh '''
                    set -Eeuo pipefail

                HOST_KUBECONFIG="/home/jenkins/.kube-host/config"
                if [ -f "$HOST_KUBECONFIG" ]; then
                    cp "$HOST_KUBECONFIG" ./kubeconfig.local
                    export KUBECONFIG="$(pwd)/kubeconfig.local"

                    HOST_HOME_PATTERN='/home/[^/]*'
                    sed -i -E "s#${HOST_HOME_PATTERN}#/hosthome#g" ./kubeconfig.local

                    kubectl config view --flatten --raw > ./kubeconfig.flat
                    mv ./kubeconfig.flat ./kubeconfig.local

                    REWRITTEN=false
                    for candidate in kind-control-plane minikube; do
                        if getent hosts "$candidate" >/dev/null 2>&1; then
                            CURRENT_SERVER="$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
                            PORT="${CURRENT_SERVER##*:}"
                            kubectl config set-cluster "$(kubectl config view --minify -o jsonpath='{.clusters[0].name}')" \
                                --server="https://${candidate}:${PORT}"
                            echo "Rewrote kubeconfig server to https://${candidate}:${PORT} for in-network reachability"
                            REWRITTEN=true
                            break
                        fi
                    done

                    if [ "$REWRITTEN" = false ]; then
                        if kubectl --kubeconfig=./kubeconfig.local cluster-info --request-timeout=5s >/dev/null 2>&1; then
                            echo "No candidate hostname (kind-control-plane/minikube) resolved, but the copied kubeconfig's server is directly reachable from this container — proceeding without rewrite."
                        else
                            echo "FATAL: Could not reach the local Kubernetes cluster from inside the Jenkins container."
                            echo "  - No candidate hostname (kind-control-plane, minikube) resolved via getent, meaning"
                            echo "    Jenkins is not attached to the cluster's Docker network."
                            echo "  - The copied kubeconfig's server is also unreachable directly."
                            echo ""
                            echo "  Fix: ensure minikube/kind is already running BEFORE deploying Jenkins, so"
                            echo "  deploy_jenkins.sh can detect and attach to its Docker network. Then redeploy"
                            echo "  Jenkins with: platform/cicd/jenkins/scripts/deploy_jenkins.sh"
                            exit 1
                        fi
                    fi
                fi

                    SCRIPT="platform/deployment/kubernetes/deploy_kubernetes.sh"
                    if [ ! -f "$SCRIPT" ]; then
                        echo "FATAL: $SCRIPT not found — repo layout may have changed"
                        exit 1
                    fi
                    chmod +x "$SCRIPT"
                    "./$SCRIPT"
                '''
            }
        }

        stage('Deploy (prod — GitOps)') {
            when { expression { return !params.SKIP_DEPLOY && env.DEPLOY_TARGET == 'prod' } }
            steps {
                echo 'Production deploys are GitOps-managed: ArgoCD syncs the new image tag from Git automatically. No direct kubectl apply is performed by this pipeline.'
            }
        }
    }

    post {
        success { echo "Build #${env.BUILD_NUMBER} succeeded (${env.DEPLOY_TARGET})" }
        failure { echo "Build #${env.BUILD_NUMBER} failed — see stage logs above" }
        always  { cleanWs() }
    }
}
